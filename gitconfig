[user]
	name = Benjamin K
	email = benjamin.kulnik@student.tuwien.ac.at

[core]
	excludesfile = ~/.gitignore

[commit]
	verbose = true

[help]
	autocorrect = prompt

[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true

[column]
	ui = auto

[fetch]
	prune = true
	pruneTags = true
	all = true

[branch]
	sort = -committerdate

[tag]
    sort = version:refname

[init]
	defaultBranch = main

[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
	renames = true

[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f

[github]
	user = tqml

[url "https://bitbucket.org/"]
	insteadOf = bb:

[url "https://github.com/"]
	insteadOf = gh:

[url "https://gist.github.com/"]
	insteadOf = gist:


# %% --- Alternative git configuration ------------------------------------------ #
# https://www.borfast.com/blog/2021/02/27/how-to-override-and-share-git-configuration-options-between-multiple-directories/

[include]
	path = "~/dotfiles/gitconfig-local"

# Generated by makesymlinks.sh based on the current OS (credential helper,
# merge tool, ...) - platform-specific, so it isn't hand-edited or committed.
[include]
	path = "~/dotfiles/gitconfig-os"

[includeIf "gitdir:~/dotfiles/"]
	path = "~/dotfiles/gitconfig-private"

[includeIf "gitdir:~/Developer/Private/"]
	path = "~/dotfiles/gitconfig-private"

[includeIf "gitdir:~/Developer/OpenSourceProjects/"]
	path = "~/dotfiles/gitconfig-private"
